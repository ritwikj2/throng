# Throng: Claude chooses intentions, remembers lessons, and communicates.
HOST=127.0.0.1
PORT=8790
THRONG_BRAIN=anthropic
THRONG_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
THRONG_CALLS_PER_MINUTE=24
THRONG_THINK_INTERVAL_SECONDS=8
THRONG_BRAIN_TIMEOUT_MS=25000
# THRONG_DATA_DIR=./data

# Use Simulation → Connect Claude, or add your key above and restart.
# Never commit your .env file.
# Without a valid key the UI reports disconnected; only body simulation runs.
# Explicit offline option: THRONG_BRAIN=local
# Other adapters: THRONG_BRAIN=openai with OPENAI_API_KEY and THRONG_MODEL;
# or THRONG_BRAIN=bedrock with a supported Claude model and your AWS credentials.
# OPENAI_BASE_URL=https://api.openai.com/v1
# AWS_REGION=us-east-1
