# Choose a brain in Simulation → Connect brain. No network calls in local mode.
HOST=127.0.0.1
PORT=8790
THRONG_BRAIN=local
THRONG_MODEL=
THRONG_CALLS_PER_MINUTE=24
THRONG_THINK_INTERVAL_SECONDS=8
THRONG_BRAIN_TIMEOUT_MS=25000
# THRONG_DATA_DIR=./data

# Supported providers: local, anthropic, openai, compatible, bedrock.
# Enter an API model ID available to your own account in THRONG_MODEL.
# Anthropic uses its Messages API; OpenAI uses its Responses API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Custom services and local servers with an OpenAI-compatible API:
COMPATIBLE_API_KEY=
# COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# COMPATIBLE_API_STYLE=chat-completions
# Alternative protocol: responses. URLs are reached from the game server.
# A custom endpoint never inherits OPENAI_API_KEY or ANTHROPIC_API_KEY.

# Claude through Bedrock uses the server's AWS credentials/profile:
# AWS_REGION=us-east-1

# The in-game connection check makes one small model request before saving.
# Editing this file manually requires restarting the server.
# Never commit your .env file.
